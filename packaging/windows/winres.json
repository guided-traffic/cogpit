{
  "RT_GROUP_ICON": {
    "GLFW_ICON": {
      "0000": "cogpit.ico"
    }
  },
  "RT_MANIFEST": {
    "#1": {
      "0409": {
        "identity": {
          "name": "",
          "version": ""
        },
        "description": "@DESCRIPTION@",
        "minimum-os": "win10",
        "execution-level": "as invoker",
        "ui-access": false,
        "auto-elevate": false,
        "dpi-awareness": "per monitor v2",
        "disable-theming": false,
        "disable-window-filtering": false,
        "high-resolution-scrolling-aware": false,
        "ultra-high-resolution-scrolling-aware": false,
        "long-path-aware": true,
        "printer-driver-isolation": false,
        "gdi-scaling": false,
        "segment-heap": false,
        "use-common-controls-v6": true
      }
    }
  },
  "RT_VERSION": {
    "#1": {
      "0000": {
        "fixed": {
          "file_version": "@VERSION@.0",
          "product_version": "@VERSION@.0"
        },
        "info": {
          "0409": {
            "Comments": "https://github.com/guided-traffic/cogpit",
            "CompanyName": "guided-traffic",
            "FileDescription": "@DESCRIPTION@",
            "FileVersion": "@VERSION@",
            "InternalName": "@NAME@",
            "LegalCopyright": "Copyright 2026 The Cogpit authors, Apache License 2.0",
            "LegalTrademarks": "",
            "OriginalFilename": "@NAME@.exe",
            "PrivateBuild": "",
            "ProductName": "Cogpit",
            "ProductVersion": "@VERSION@",
            "SpecialBuild": ""
          }
        }
      }
    }
  }
}
